# Names only; values live in qone-infra/.env (never versioned). Everything the service reads.
IDENTITY_DATABASE_URL=postgresql://identity:password@identity-db:5432/identity
# The only private key of the platform, mounted into this service alone (norm 5.3.7, 5.9.2).
JWT_PRIVATE_KEY_FILE=/run/secrets/jwt-private.pem
TOKEN_LIFETIME_HOURS=8
PORT=8000
LOG_LEVEL=info
