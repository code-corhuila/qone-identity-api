# Names only; values live in qone-infra/.env (never versioned). Everything the service reads.
IDENTITY_DATABASE_URL=postgresql://identity:password@identity-db:5432/identity
# The only private key of the platform, mounted into this service alone (norm 5.3.7, 5.9.2).
JWT_PRIVATE_KEY_FILE=/run/secrets/jwt-private.pem
TOKEN_LIFETIME_HOURS=8
PORT=8000
LOG_LEVEL=info
# develop, qa or main. Only develop allows the in-memory store and a default ADMIN e-mail.
APP_ENV=develop
# The ADMIN the service creates at start (id 33333333-3333-4333-8333-333333333331); never seeded.
# Outside develop both are required and the password has 12+ characters and is not DEMO_PASSWORD.
BOOTSTRAP_ADMIN_EMAIL=admin@qampus.test
BOOTSTRAP_ADMIN_PASSWORD=
# The password of the develop demo people (in-memory store): the one of qone-infra/.env.
DEMO_PASSWORD=
